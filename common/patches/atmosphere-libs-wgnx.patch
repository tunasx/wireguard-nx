 #include <stratosphere/sf/cmif/sf_cmif_pointer_and_size.hpp>
@@ -89,13 +90,66 @@ namespace ams::sf::hipc {
 
             Result ForwardRequest(const cmif::ServiceDispatchContext &ctx) const;
 
-            static inline void ForwardServiceDeleter(Service *srv) {
-                serviceClose(srv);
-                delete srv;
+            /* System modules intentionally have no newlib heap for this lifetime. */
+            struct ForwardServiceAllocatorTag;
+            using ForwardServiceHeapAllocator = sf::ExpHeapStaticAllocator<8_KB, ForwardServiceAllocatorTag>;
+
+            struct ForwardServiceHolder {
+                ::Service service;
+
+                ForwardServiceHolder() : service{} {
+                    service.session = INVALID_HANDLE;
+                }
+
+                ~ForwardServiceHolder() {
+                    if (serviceIsActive(std::addressof(service))) {
+                        serviceClose(std::addressof(service));
+                    }
+                }
+            };
+
+            template<typename T>
+            class ForwardServiceSharedAllocator : public std::allocator<T> {
+              public:
+                template<typename U>
+                struct rebind {
+                    using other = ForwardServiceSharedAllocator<U>;
+                };
+
+                ForwardServiceSharedAllocator() = default;
+
+                template<typename U>
+                ForwardServiceSharedAllocator(const ForwardServiceSharedAllocator<U>&) {
+                }
+
+                [[nodiscard]] T* allocate(::std::size_t n) {
+                    EnsureForwardServiceAllocatorInitialized();
+                    return static_cast<T*>(ForwardServiceHeapAllocator::Allocate(sizeof(T) * n));
+                }
+
+                void deallocate(T* p, ::std::size_t n) {
+                    ForwardServiceHeapAllocator::Deallocate(p, sizeof(T) * n);
+                }
+            };
+
+            static inline void EnsureForwardServiceAllocatorInitialized() {
+                static constinit os::SdkMutex s_allocator_mutex;
+                static constinit bool s_allocator_initialized = false;
+
+                if (AMS_UNLIKELY(!s_allocator_initialized)) {
+                    std::scoped_lock lk(s_allocator_mutex);
+                    if (AMS_LIKELY(!s_allocator_initialized)) {
+                        ForwardServiceHeapAllocator::Initialize(lmem::CreateOption_ThreadSafe);
+                        s_allocator_initialized = true;
+                    }
+                }
             }
 
             static inline std::shared_ptr<::Service> CreateForwardService() {
-                return std::shared_ptr<::Service>(new ::Service(), ForwardServiceDeleter);
+                EnsureForwardServiceAllocatorInitialized();
+
+                auto holder = std::allocate_shared<ForwardServiceHolder>(ForwardServiceSharedAllocator<ForwardServiceHolder>{});
+                return std::shared_ptr<::Service>(std::move(holder), std::addressof(holder->service));
             }
             #endif
     };
