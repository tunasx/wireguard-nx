@@ -16,6 +16,7 @@
 
 #pragma once
 #include <stratosphere/sf/sf_common.hpp>
+#include <stratosphere/sf/sf_exp_heap_allocator.hpp>
 #include <stratosphere/sf/sf_mitm_config.hpp>
